#!/usr/bin/env node
'use strict';

// One CLI for every Shipyard step: `node bin/shipyard <step> [options]`.
// A step lives in lib/<step>-command.js and exports run(argv, io) -> exit code.

const STEPS = {
  'changelog-line': () => require('../lib/changelog-line-command'),
  'lint-prep': () => require('../lib/lint-prep-command'),
  facts: () => require('../lib/facts-command'),
  contract: () => require('../lib/contract-command'),
  changelog: () => require('../lib/changelog-command'),
  cut: () => require('../lib/cut-command'),
  'release-check': () => require('../lib/release-check-command'),
  record: () => require('../lib/record-command'),
  'release-gate': () => require('../lib/release-gate-command'),
  ask: () => require('../lib/ask-command'),
  tag: () => require('../lib/tag-command'),
  deployment: () => require('../lib/deployment-command'),
  'docs-preview': () => require('../lib/docs-preview-command'),
  'site-docs-preview': () => require('../lib/site-docs-preview-command'),
  'docs-publish': () => require('../lib/docs-publish-command'),
  'merge-back': () => require('../lib/merge-back-command'),
  announce: () => require('../lib/announce-command'),
  start: () => require('../lib/start-command'),
  pin: () => require('../lib/pin-command'),
  'private-data': () => require('../lib/private-data-command'),
  publish: () => require('../lib/publish-command'),
  'secret-scan': () => require('../lib/secret-scan-command'),
  prerelease: () => require('../lib/prerelease-command'),
  'release-version': () => require('../lib/release-version-command'),
  homebrew: () => require('../lib/homebrew-command'),
  'changelog-page': () => require('../lib/changelog-page-command'),
  'open-release-pr': () => require('../lib/open-release-pr-command'),
  'cli-results': () => require('../lib/cli-results-command'),
};

async function main(argv) {
  const [step, ...rest] = argv;
  if (!step || step === '--help' || step === '-h') {
    process.stdout.write(`Usage: shipyard <step> [options]\n\nSteps:\n${Object.keys(STEPS).map((s) => `  ${s}`).join('\n')}\n`);
    return step ? 0 : 2;
  }
  if (!Object.hasOwn(STEPS, step)) {
    process.stderr.write(`shipyard: unknown step "${step}". Steps: ${Object.keys(STEPS).join(', ')}\n`);
    return 2;
  }
  return STEPS[step]().run(rest, { env: process.env, stdout: process.stdout, stderr: process.stderr });
}

main(process.argv.slice(2)).then(
  (code) => {
    process.exitCode = code;
  },
  (err) => {
    process.stderr.write(`shipyard: ${err && err.message ? err.message : err}\n`);
    process.exitCode = 2;
  },
);
